# Secrets can come from the environment instead of config.toml (e.g. with direnv).
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
NUJIJUSHI_UI_TOKEN=change-me-to-a-long-random-string
# Telegram ids that may administer the bot (comma separated); find yours with /whoami
NUJIJUSHI_ADMINS=123456789
# NUJIJUSHI_BOT=0   # disable the Telegram command interface
# NUJIJUSHI_BOT_MODE=webhook
# NUJIJUSHI_WEBHOOK_URL=https://bot.example.com
# NUJIJUSHI_WEBHOOK_SECRET=change-me
# NUJIJUSHI_HOME=/Users/you/.nujijushi
# NUJIJUSHI_BIND=127.0.0.1:8788
# NUJIJUSHI_WEB_BASE_PATH=/archive
# NUJIJUSHI_GALLERY_DL=/opt/homebrew/bin/gallery-dl
# NUJIJUSHI_PROXY=socks5h://127.0.0.1:1080
# NUJIJUSHI_NO_PROXY=localhost,127.0.0.1,.lan
