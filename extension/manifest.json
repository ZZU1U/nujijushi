{
  "manifest_version": 3,
  "name": "nujijushi clip",
  "version": "0.1.0",
  "description": "Clip artwork URLs or send posts directly to your nujijushi server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "nujijushi clip"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "clip-tab": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Clip the current page"
    },
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open the clip panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://www.pixiv.net/*",
        "https://pixiv.net/*",
        "https://rednote.com/*",
        "https://www.rednote.com/*",
        "https://xiaohongshu.com/*",
        "https://www.xiaohongshu.com/*",
        "https://*.fanbox.cc/*"
      ],
      "js": [
        "content/clip.js",
        "lib/canonical.js",
        "content/sites/x.js",
        "content/sites/pixiv.js",
        "content/sites/rednote.js",
        "content/sites/generic.js"
      ],
      "css": ["content/clip.css"],
      "run_at": "document_idle"
    }
  ]
}
